<Window x:Class="FixMathpix2025.SpellingCorrectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FixMathpix2025"
        mc:Ignorable="d"
        Title="Quản lý lỗi chính tả" Height="450" Width="800"
        Background="#FF2D2D30" Foreground="White" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None">
    <Window.Resources>
        <!-- Re-use existing styles from MainWindow.xaml for consistency -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FF555555"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FF555555"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#FF2D2D30"/>
            <Setter Property="AlternatingRowBackground" Value="#FF3F3F46"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF555555"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="CorrectionsDataGrid" Grid.Row="0" Margin="0,0,0,10"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  SelectionChanged="CorrectionsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Từ sai" Binding="{Binding FindText}" Width="*"/>
                <DataGridTextColumn Header="Thay thế bằng" Binding="{Binding ReplaceText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,5,0,10">
            <TextBlock Text="Tìm kiếm / Lọc:"/>
            <TextBox x:Name="SearchTextBox" Margin="0,0,0,10" TextChanged="SearchTextBox_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Từ sai:"/>
            <TextBox x:Name="FindTextBox" Margin="0,0,0,5"/>
            <TextBlock Text="Thay thế bằng:"/>
            <TextBox x:Name="ReplaceTextBox" Margin="0,0,0,5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddButton" Width="45" Height="26" Content="Thêm" Margin="0,0,5,0" Click="AddButton_Click"/>
            <Button x:Name="EditButton" Width="45"  Content="Sửa" Margin="0,0,5,0" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Width="45"  Content="Xóa" Margin="0,0,15,0" Click="DeleteButton_Click"/>
            <Button x:Name="SaveButton" Width="45"  Content="Lưu" Margin="0,0,5,0" Click="SaveButton_Click"/>
            <Button x:Name="CloseButton" Width="45"  Content="Đóng" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>