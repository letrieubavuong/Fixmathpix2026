                </DockPanel>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="11">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="Phần" Width="35"  VerticalAlignment="Center"/>
                    <ComboBox x:Name="PhanComboBox" Width="65"  Height="28" VerticalContentAlignment="Center" Style="{StaticResource DarkComboBoxStyle}" Margin="5,3,0,3" SelectedIndex="0">
                        <ComboBoxItem>I</ComboBoxItem>
                        <ComboBoxItem>II</ComboBoxItem>
                        <ComboBoxItem>III</ComboBoxItem>
                        <ComboBoxItem>IV</ComboBoxItem>
                    </ComboBox>
                </DockPanel>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="12" HorizontalAlignment="Stretch" Margin="3">
                <Button HorizontalAlignment="Stretch" Click="CauhoiButton_Click" ToolTip="Chèn cấu trúc câu hỏi dựa trên Phần và Bài đã chọn.">
                    <TextBlock Text="Câu hỏi" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="12" HorizontalAlignment="Stretch" Margin="3">
                <Button HorizontalAlignment="Stretch" Click="SortQuestions_Click" ToolTip="Sắp xếp câu hỏi theo cấu trúc Phần I, II, III, IV.">
                    <TextBlock Text="Sắp xếp" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="9" HorizontalAlignment="Stretch" Margin="3">
                <Button HorizontalAlignment="Stretch" Click="FixHevaButton_Click" ToolTip="Sửa khối \heva{} hiện tại và tìm khối tiếp theo.">
                    <DockPanel VerticalAlignment="Center" Width="70">
                        <iconPacks:PackIconMaterial Kind="AutoFix" 
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" Height="20"/>
                        <TextBlock Text="\heva{}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                    </DockPanel>
                </Button>
            </Grid>
            <!-- Table Creation Controls -->
            <Grid Grid.Row="0" Grid.Column="13" Grid.RowSpan="2" HorizontalAlignment="Stretch" Margin="3">
                <Button HorizontalAlignment="Stretch" Click="BangButton_Click" ToolTip="Mở wizard để tạo bảng LaTeX.">
                    <DockPanel VerticalAlignment="Center" Width="70">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Table" VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="Tạo bảng" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="14">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="Độ rộng" Width="45" Margin="3,0,0,0"  VerticalAlignment="Center"/>
                    <ComboBox x:Name="Doronghinhanh" Width="45"  Height="28" VerticalContentAlignment="Center" Style="{StaticResource DarkComboBoxStyle}" Margin="5,3,0,3" SelectedIndex="0">
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                    </ComboBox>
                </DockPanel>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="14" HorizontalAlignment="Stretch" Margin="3">
                <Button HorizontalAlignment="Stretch" Click="HinhanhButton_Click" ToolTip="Chèn môi trường hình ảnh với độ rộng đã chọn.">
                    <DockPanel VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ImageArea" 
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" Height="20"/>
                        <TextBlock Text="Hình ảnh" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                    </DockPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="15" HorizontalAlignment="Stretch" Margin="3">
                <!-- TrueButton moved from 9 to 10 -->
                <Button HorizontalAlignment="Stretch" Click="ImminiButton_Click" ToolTip="Chèn lệnh \immini{} cho đoạn văn bản đã chọn.">
                    <DockPanel VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="CheckBold" 
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" Height="20"/>
                        <TextBlock Text="\immini " VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    </DockPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="15" HorizontalAlignment="Stretch" Margin="3">
                <Button HorizontalAlignment="Stretch" Click="ImminiThmButton_Click" ToolTip="Chèn lệnh \immini[thm]{} cho đoạn văn bản đã chọn.">
                    <DockPanel VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="LightbulbOnOutline" 
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" Height="20"/>
                        <TextBlock Text="\immini[thm] " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                    </DockPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="16" Grid.RowSpan="2" HorizontalAlignment="Stretch" Margin="3">
                <Button x:Name="FixMenuButton" HorizontalAlignment="Stretch" Click="FixMenuButton_Click" ToolTip="Các công cụ sửa lỗi và chuẩn hóa">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AutoFix" VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" Height="20"/>
                        <TextBlock Text="Công cụ Fix" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <iconPacks:PackIconMaterial Kind="ChevronDown" Width="10" Height="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="FixHevaButton_Click" ToolTip="Sửa khối \heva{} hiện tại và tìm khối tiếp theo.">
                                <MenuItem.Header>
                                    <DockPanel>
                                        <iconPacks:PackIconMaterial Kind="AutoFix" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Sửa \heva{}"/>
                                    </DockPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Click="FixEnumerateButton_Click" ToolTip="Chuyển đổi môi trường enumerate thành listEX trong các khối vd, vidu, ex, bt.">
                                <MenuItem.Header>
                                    <DockPanel>
                                        <iconPacks:PackIconMaterial Kind="FormatListNumbered" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Fix enumerate"/>
                                    </DockPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Click="FixTikzpictureButton_Click" ToolTip="Chuẩn hóa các tùy chọn trong môi trường tikzpicture.">
                                <MenuItem.Header>
                                    <DockPanel>
                                        <iconPacks:PackIconMaterial Kind="Drawing" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Fix tikzpicture"/>
                                    </DockPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator Background="#FF555555"/>
                            <MenuItem Command="local:CustomCommands.CleanupText" ToolTip="Dọn dẹp khoảng trắng, dấu câu...">
                                <MenuItem.Header>
                                    <DockPanel>
                                        <iconPacks:PackIconMaterial Kind="Broom" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Dọn dẹp văn bản"/>
                                    </DockPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="17" Grid.RowSpan="2" HorizontalAlignment="Stretch" Margin="3">
                <Button HorizontalAlignment="Stretch" Click="InsertImageWizardButton_Click" ToolTip="Chèn hình ảnh nâng cao">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ImagePlus" VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="Chèn ảnh" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="18" Grid.RowSpan="2" HorizontalAlignment="Stretch" Margin="3">
                <Button HorizontalAlignment="Stretch" Click="Ghepfile_Click" ToolTip="Chèn hình ảnh nâng cao">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ImagePlus" VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="Ghép file" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </Grid>
        </Grid>
        <avalonedit:TextEditor
            Grid.Row="1"
            x:Name="textEditor"
            FontFamily="Tono Mono"
            FontSize="12pt"
            Background="#FF1E1E1E"
            Foreground="#FFDCDCDC"
            ShowLineNumbers="True"
            Margin="0,5,0,0"
            WordWrap="True"
            >
            <avalonedit:TextEditor.InputBindings>
                <!-- Gán phím tắt Ctrl+W cho lệnh đóng tệp -->
                <KeyBinding Command="{x:Static local:MainWindow.CloseTexCommand}"
                            Key="W" Modifiers="Ctrl"/>

                <!-- Gán phím tắt Ctrl+Shift+U cho lệnh viết hoa -->
                <KeyBinding Command="avalonedit:AvalonEditCommands.ConvertToUppercase"
                            Key="U" Modifiers="Ctrl+Shift"/>
                <KeyBinding Command="local:CustomCommands.MathMode" Key="M" Modifiers="Ctrl"/>
                <KeyBinding Command="local:CustomCommands.SpellCheck" Key="F7" Modifiers="Ctrl"/>
                <KeyBinding Key="L" Modifiers="Ctrl" Command="local:CustomCommands.InsertLoigiai"/>
                <KeyBinding Command="local:CustomCommands.ToggleComment" Key="T" Modifiers="Ctrl"/>
                <KeyBinding Command="local:CustomCommands.ToggleComment" Key="U" Modifiers="Ctrl"/>
                <KeyBinding Command="ApplicationCommands.Find" Key="F" Modifiers="Ctrl"/>
                <KeyBinding Command="ApplicationCommands.Replace" Key="H" Modifiers="Ctrl"/>


            </avalonedit:TextEditor.InputBindings>
            <avalonedit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Cut">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ContentCut" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cắt"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="ApplicationCommands.Copy">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Sao chép"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="ApplicationCommands.Paste">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ContentPaste" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Dán"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="avalonedit:AvalonEditCommands.ConvertToUppercase">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="FormatLetterCaseUpper" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Viết hoa"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="TitleCaseDang_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="FormatTitle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Viết hoa tiêu đề dạng toán"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="UppercaseSection_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="FormatHeader1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Viết hoa mục (section)"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="SortQuestions_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="Sort" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Sắp xếp câu hỏi"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="local:CustomCommands.ToggleComment">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="CommentTextOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chuyển đổi Ghi chú"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="local:CustomCommands.CleanupText">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="Broom" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Dọn dẹp văn bản"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="LabelMenuItem_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="Label" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chèn \label{}"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="RefMenuItem_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="Tag" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chèn \ref{}"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator Background="#FF555555"/>
                    <MenuItem Command="ApplicationCommands.SelectAll">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="SelectAll" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chọn tất cả"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator Background="#FF555555"/>
                    <MenuItem Click="ExpandAllFoldings_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ArrowExpandAll" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Mở tất cả"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="CollapseAllFoldings_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ArrowCollapseAll" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Đóng tất cả"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </avalonedit:TextEditor.ContextMenu>
        </avalonedit:TextEditor>
    </Grid>
</Window>
