<Window x:Class="FixMathpix2025.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FixMathpix2025"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"

        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" d:DataContext="{d:DesignInstance Type=local:HighlightingColorViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920"
        Background="#FF2D2D30" Foreground="White" WindowStartupLocation="CenterScreen" WindowState="Maximized">    <Window.CommandBindings>
        <CommandBinding Command="local:CustomCommands.Bold" Executed="BoldButton_Click" />
        <CommandBinding Command="local:CustomCommands.Italic" Executed="ItalicButton_Click" />
        <CommandBinding Command="local:CustomCommands.Underline" Executed="UnderlineButton_Click" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenFile_Click" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveFileButton_Click" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="FindReplace_Executed" />
        <CommandBinding Command="ApplicationCommands.Replace" Executed="FindReplace_Executed" />
        <CommandBinding Command="local:CustomCommands.ToggleComment" Executed="ToggleComment_Click" />
        <CommandBinding Command="local:CustomCommands.CleanupText" Executed="CleanupText_Click" />
        <CommandBinding Command="local:CustomCommands.InsertEnvironment" Executed="InsertEnvironment_Executed" />
        <CommandBinding Command="local:CustomCommands.InsertFigure" Executed="InsertFigure_Executed" />
        <CommandBinding Command="local:CustomCommands.MathMode" Executed="MathModeButton_Click" />
        <CommandBinding Command="local:CustomCommands.SpellCheck" Executed="SpellCheckButton_Click" />
        <CommandBinding Command="local:CustomCommands.InsertLoigiai" Executed="LoigiaiButton_Click" />
        <CommandBinding Command="local:CustomCommands.GoToLine" Executed="GoToLine_Executed" />
    </Window.CommandBindings>


    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CenterAlignedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenterAlignedButtonWithIcon" TargetType="Button" BasedOn="{StaticResource CenterAlignedButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="3" Background="#FF686868" BorderBrush="Transparent" BorderThickness="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Border Background="#FF2D2D30" />
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3,5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>

        <!-- Template cho các mục Menu cấp cao (Tệp, Chỉnh sửa, LaTeX...) có chứa Menu con -->
        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Border" Background="Transparent" Padding="10,4" SnapsToDevicePixels="True">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" Focusable="False" PopupAnimation="Fade">
                        <Border Background="#FF2D2D30" BorderBrush="#FF555555" BorderThickness="1" Padding="2" CornerRadius="3">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#FF555555"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Template cho các mục Menu con và ContextMenu -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Border" Background="Transparent" Padding="8,5" SnapsToDevicePixels="True" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="Icon"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="Icon" Margin="0,0,8,0" VerticalAlignment="Center" ContentSource="Icon"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#FF555555"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Gray"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Style MenuItem mặc định cho toàn Window -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Main Menu -->
            <RowDefinition Height="Auto"/> <!-- Responsive Toolbar (WrapPanel) -->
            <RowDefinition Height="*"/>    <!-- TextEditor -->
            <RowDefinition Height="Auto"/> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- 1. Thanh Menu chính -->
        <Menu Grid.Row="0" Background="#FF2D2D30" Foreground="White" BorderThickness="0,0,0,1" BorderBrush="#FF555555" Padding="5,2">
            <Menu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Padding" Value="10,4"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_Tệp">
                <MenuItem Command="ApplicationCommands.Open" Header="_Mở tệp TeX...">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="ApplicationCommands.Save" Header="_Lưu tệp TeX">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="CloseFile_Click" Header="Đó_ng tệp TeX">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="FileRemoveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#FF555555"/>
                <MenuItem Click="Exit_Click" Header="Th_oát"/>
            </MenuItem>
            <MenuItem Header="_Chỉnh sửa">
                <MenuItem Command="ApplicationCommands.Cut" Header="Cắ_t"/>
                <MenuItem Command="ApplicationCommands.Copy" Header="_Sao chép"/>
                <MenuItem Command="ApplicationCommands.Paste" Header="_Dán"/>
                <Separator Background="#FF555555"/>
                <MenuItem Command="ApplicationCommands.Find" Header="_Tìm kiếm (Ctrl+F)">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Magnify" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="ApplicationCommands.Replace" Header="Th_ay thế (Ctrl+H)"/>
                <MenuItem Command="local:CustomCommands.GoToLine" Header="Đi _tới dòng..."/>
                <Separator Background="#FF555555"/>
                <MenuItem Command="local:CustomCommands.SpellCheck" Header="_Soát lỗi chính tả (Ctrl+F7)">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Spellcheck" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="ManageSpellingButton_Click" Header="Quản lý _từ điển lỗi...">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="BookEditOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#FF555555"/>
                <MenuItem Command="ApplicationCommands.SelectAll" Header="Chọ_n tất cả"/>
            </MenuItem>
            <MenuItem Header="_LaTeX">
                <MenuItem Click="CauhoiButton_Click" Header="Chèn cấu trúc câu hỏi"/>
                <MenuItem Click="SortQuestions_Click" Header="Sắp xếp câu hỏi"/>
                <Separator Background="#FF555555"/>
                <MenuItem Command="local:CustomCommands.MathMode" Header="Môi trường toán ($...$)"/>
                <MenuItem Click="AlignStarButton_Click" Header="Môi trường align*"/>
                <MenuItem Click="EquationButton_Click" Header="Môi trường equation"/>
                <MenuItem Click="ShortAnsButton_Click" Header="Lệnh \shortans"/>
                <Separator Background="#FF555555"/>
                <MenuItem Click="ItemizeButton_Click" Header="Danh sách Itemize"/>
                <MenuItem Click="EnumerateButton_Click" Header="Danh sách Enumerate"/>
                <MenuItem Click="ItemChoiceButton_Click" Header="Danh sách ItemChoice"/>
                <Separator Background="#FF555555"/>
                <MenuItem Click="BangButton_Click" Header="Tạo bảng (Table Wizard)..."/>
                <MenuItem Click="HinhanhButton_Click" Header="Chèn hình ảnh (Đường dẫn &amp; Độ rộng)..."/>
                <MenuItem Click="InsertImageWizardButton_Click" Header="Chèn hình ảnh nâng cao..."/>
                <MenuItem Click="ImminiButton_Click" Header="Chèn \immini"/>
                <MenuItem Click="ImminiThmButton_Click" Header="Chèn \immini[thm]"/>
            </MenuItem>
            <MenuItem Header="Côn_g cụ">
                <MenuItem Click="ChuyenTeXButton_Click" Header="Chuyển đổi TeX chuẩn">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Run" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="local:CustomCommands.CleanupText" Header="Dọn dẹp văn bản">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Broom" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#FF555555"/>
                <MenuItem Click="FixHevaButton_Click" Header="Sửa \heva{}"/>
                <MenuItem Click="FixEnumerateButton_Click" Header="Fix Enumerate sang listEX"/>
                <MenuItem Click="FixTikzpictureButton_Click" Header="Fix Tikzpicture"/>
                <MenuItem Click="Ghepfile_Click" Header="Ghép các file TeX..."/>
            </MenuItem>
            <MenuItem Header="_Cài đặt">
                <MenuItem Click="SettingsButton_Click" Header="Cài đặt cấu hình editor...">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Cog" Width="14" Height="14" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 2. Thanh công cụ responsive (WrapPanel) -->
        <Border Grid.Row="1" Background="#FF2D2D30" BorderThickness="0,0,0,1" BorderBrush="#FF555555" Padding="5,2">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">


                <!-- Group 2: Text Formatting -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BoldButton" Style="{StaticResource CenterAlignedButtonWithIcon}" Command="local:CustomCommands.Bold" ToolTip="In đậm (Ctrl+B)">
                        <iconPacks:PackIconMaterial Kind="FormatBold" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ItalicButton" Style="{StaticResource CenterAlignedButtonWithIcon}" Command="local:CustomCommands.Italic" ToolTip="In nghiêng (Ctrl+I)">
                        <iconPacks:PackIconMaterial Kind="FormatItalic" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="UnderlineButton" Style="{StaticResource CenterAlignedButtonWithIcon}" Command="local:CustomCommands.Underline" ToolTip="Gạch chân (Ctrl+U)">
                        <iconPacks:PackIconMaterial Kind="FormatUnderline" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="AlignLeftButton" Style="{StaticResource CenterAlignedButtonWithIcon}" Click="AlignLeftButton_Click" ToolTip="Căn lề trái">
                        <iconPacks:PackIconMaterial Kind="FormatAlignLeft" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="AlignCenterButton" Style="{StaticResource CenterAlignedButtonWithIcon}" Click="AlignCenterButton_Click" ToolTip="Căn lề giữa">
                        <iconPacks:PackIconMaterial Kind="FormatAlignCenter" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="AlignRightButton" Style="{StaticResource CenterAlignedButtonWithIcon}" Click="AlignRightButton_Click" ToolTip="Căn lề phải">
                        <iconPacks:PackIconMaterial Kind="FormatAlignRight" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#FF555555" Margin="6,4" Height="22" VerticalAlignment="Center"/>

                <!-- Group 3: Command & Structures -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CommandComboBox" Style="{StaticResource DarkComboBoxStyle}" Width="100" Margin="2" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem>chapter</ComboBoxItem>
                        <ComboBoxItem>section</ComboBoxItem>
                        <ComboBoxItem>subsection</ComboBoxItem>
                        <ComboBoxItem>subsubsection</ComboBoxItem>
                        <ComboBoxItem>paragraph</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="ApplyCommandButton" Margin="2" Padding="6,3" Click="ApplyCommandButton_Click" ToolTip="Áp dụng lệnh đã chọn cho văn bản">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentPaste" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Áp dụng" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#FF555555" Margin="6,4" Height="22" VerticalAlignment="Center"/>

                <!-- Group 4: listEX / enumEX -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cột:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="2,0"/>
                    <ComboBox x:Name="ListColumnCountComboBox" Width="40" Style="{StaticResource DarkComboBoxStyle}" Margin="2" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Kiểu:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <ComboBox x:Name="EnumStyleComboBox" Width="45" Style="{StaticResource DarkComboBoxStyle}" Margin="2" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem>a)</ComboBoxItem>
                        <ComboBoxItem>a.</ComboBoxItem>
                        <ComboBoxItem>(a)</ComboBoxItem>
                        <ComboBoxItem>1)</ComboBoxItem>
                        <ComboBoxItem>1.</ComboBoxItem>
                        <ComboBoxItem>(1)</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="ListEXButton" Margin="2" Padding="6,3" Click="ListEXButton_Click" ToolTip="Chèn môi trường listEX">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FormatListBulleted" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="listEX" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EnumEXButton" Margin="2,2,4,2" Padding="6,3" Click="EnumEXButton_Click" ToolTip="Chèn môi trường enumEX">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FormatListNumbered" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="enumEX" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#FF555555" Margin="6,4" Height="22" VerticalAlignment="Center"/>

                <!-- Group 5: Lists & Environments -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ItemizeButton" Style="{StaticResource CenterAlignedButtonWithIcon}" ToolTip="Danh sách itemize" Click="ItemizeButton_Click">
                        <iconPacks:PackIconMaterial Kind="FormatListBulleted" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="EnumerateButton" Style="{StaticResource CenterAlignedButtonWithIcon}" ToolTip="Danh sách enumerate" Click="EnumerateButton_Click">
                        <iconPacks:PackIconMaterial Kind="FormatListNumbered" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ItemChoiceButton" Style="{StaticResource CenterAlignedButtonWithIcon}" ToolTip="Danh sách itemchoice" Click="ItemChoiceButton_Click">
                        <iconPacks:PackIconMaterial Kind="FormatListChecks" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MathModeButton" Style="{StaticResource CenterAlignedButtonWithIcon}" ToolTip="Chèn Math Mode $...$ (Ctrl+M)" Command="local:CustomCommands.MathMode">
                        <TextBlock Text="$...$" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="AlignStarButton" Style="{StaticResource CenterAlignedButtonWithIcon}" ToolTip="Môi trường align*" Click="AlignStarButton_Click">
                        <TextBlock Text="align*" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ShortAnsButton" Style="{StaticResource CenterAlignedButtonWithIcon}" ToolTip="Lệnh \shortans" Click="ShortAnsButton_Click">
                        <TextBlock Text="\sa" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="EquationButton" Style="{StaticResource CenterAlignedButtonWithIcon}" ToolTip="Môi trường equation" Click="EquationButton_Click">
                        <TextBlock Text="eq" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#FF555555" Margin="6,4" Height="22" VerticalAlignment="Center"/>

                <!-- Group 6: Core Converter -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ChuyenTeXButton" Click="ChuyenTeXButton_Click" ToolTip="Chuyển đổi văn bản TeX sang chuẩn (ChuyenTeX)." Margin="2" Padding="6,3" Style="{StaticResource CenterAlignedButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Run" Width="14" Height="14" VerticalAlignment="Center" Foreground="#FF007ACC"/>
                            <TextBlock Text="Chuyển TeX" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#FF555555" Margin="6,4" Height="22" VerticalAlignment="Center"/>

                <!-- Group 7: Questions & Helper Tags -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bài:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="2,0"/>
                    <ComboBox x:Name="BaiComboBox" Width="50" Style="{StaticResource DarkComboBoxStyle}" Margin="2" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem>01</ComboBoxItem>
                        <ComboBoxItem>02</ComboBoxItem>
                        <ComboBoxItem>03</ComboBoxItem>
                        <ComboBoxItem>04</ComboBoxItem>
                        <ComboBoxItem>05</ComboBoxItem>
                        <ComboBoxItem>06</ComboBoxItem>
                        <ComboBoxItem>07</ComboBoxItem>
                        <ComboBoxItem>08</ComboBoxItem>
                        <ComboBoxItem>09</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                        <ComboBoxItem>11</ComboBoxItem>
                        <ComboBoxItem>12</ComboBoxItem>
                        <ComboBoxItem>13</ComboBoxItem>
                        <ComboBoxItem>14</ComboBoxItem>
                        <ComboBoxItem>15</ComboBoxItem>
                        <ComboBoxItem>16</ComboBoxItem>
                        <ComboBoxItem>17</ComboBoxItem>
                        <ComboBoxItem>18</ComboBoxItem>
                        <ComboBoxItem>19</ComboBoxItem>
                        <ComboBoxItem>20</ComboBoxItem>
                        <ComboBoxItem>21</ComboBoxItem>
                        <ComboBoxItem>22</ComboBoxItem>
                        <ComboBoxItem>23</ComboBoxItem>
                        <ComboBoxItem>24</ComboBoxItem>
                        <ComboBoxItem>25</ComboBoxItem>
                        <ComboBoxItem>26</ComboBoxItem>
                        <ComboBoxItem>27</ComboBoxItem>
                        <ComboBoxItem>28</ComboBoxItem>
                        <ComboBoxItem>29</ComboBoxItem>
                        <ComboBoxItem>30</ComboBoxItem>
                        <ComboBoxItem>31</ComboBoxItem>
                        <ComboBoxItem>32</ComboBoxItem>
                        <ComboBoxItem>33</ComboBoxItem>
                        <ComboBoxItem>34</ComboBoxItem>
                        <ComboBoxItem>35</ComboBoxItem>
                        <ComboBoxItem>36</ComboBoxItem>
                        <ComboBoxItem>37</ComboBoxItem>
                        <ComboBoxItem>38</ComboBoxItem>
                        <ComboBoxItem>39</ComboBoxItem>
                        <ComboBoxItem>40</ComboBoxItem>
                        <ComboBoxItem>41</ComboBoxItem>
                        <ComboBoxItem>42</ComboBoxItem>
                        <ComboBoxItem>43</ComboBoxItem>
                        <ComboBoxItem>44</ComboBoxItem>
                        <ComboBoxItem>45</ComboBoxItem>
                        <ComboBoxItem>46</ComboBoxItem>
                        <ComboBoxItem>47</ComboBoxItem>
                        <ComboBoxItem>48</ComboBoxItem>
                        <ComboBoxItem>49</ComboBoxItem>
                        <ComboBoxItem>50</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Phần:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <ComboBox x:Name="PhanComboBox" Width="50" Style="{StaticResource DarkComboBoxStyle}" Margin="2" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem>I</ComboBoxItem>
                        <ComboBoxItem>II</ComboBoxItem>
                        <ComboBoxItem>III</ComboBoxItem>
                        <ComboBoxItem>IV</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="CauhoiButton" Margin="2" Padding="6,3" Click="CauhoiButton_Click" ToolTip="Chèn cấu trúc câu hỏi dựa trên phần/bài đã chọn.">
                        <TextBlock Text="Câu hỏi" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="SortQuestionsButton" Margin="2" Padding="6,3" Click="SortQuestions_Click" ToolTip="Sắp xếp câu hỏi tự động.">
                        <TextBlock Text="Sắp xếp" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="CauDSButton" Margin="2" Padding="6,3" Click="CauDSButton_Click" ToolTip="Chuyển danh sách thành câu hỏi Đúng/Sai.">
                        <TextBlock Text="Câu Đ/S" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#FF555555" Margin="6,4" Height="22" VerticalAlignment="Center"/>

                <!-- Group 8: Special Commands & Snippets -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="TrueButton_Click" ToolTip="Chèn \True" Margin="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CheckBold" Width="12" Height="12" VerticalAlignment="Center" Foreground="LightGreen"/>
                            <TextBlock Text="\True" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="local:CustomCommands.InsertLoigiai" ToolTip="Chèn \loigiai{} (Ctrl+L)" Margin="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="LightbulbOnOutline" Width="12" Height="12" VerticalAlignment="Center" Foreground="Gold"/>
                            <TextBlock Text="Lời giải" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="FixHevaButton_Click" ToolTip="Sửa cấu trúc \heva" Margin="2" Padding="6,3">
                        <TextBlock Text="\heva" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#FF555555" Margin="6,4" Height="22" VerticalAlignment="Center"/>

                <!-- Group 9: Tables & Images -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BangButton_Click" ToolTip="Tạo bảng LaTeX (Table Wizard)" Margin="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Table" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Bảng" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Rộng:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <ComboBox x:Name="Doronghinhanh" Width="40" Style="{StaticResource DarkComboBoxStyle}" Margin="2" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                    </ComboBox>
                    <Button Click="HinhanhButton_Click" ToolTip="Chèn hình ảnh với độ rộng đã chọn" Margin="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ImageArea" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Ảnh" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="ImminiButton_Click" ToolTip="Chèn \immini" Margin="2" Padding="6,3">
                        <TextBlock Text="\immini" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="ImminiThmButton_Click" ToolTip="Chèn \immini[thm]" Margin="2" Padding="6,3">
                        <TextBlock Text="\immini[thm]" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#FF555555" Margin="6,4" Height="22" VerticalAlignment="Center"/>

                <!-- Group 10: Advanced Tools -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Menu Background="Transparent" Foreground="White" VerticalAlignment="Center" Margin="2">
                        <MenuItem Style="{StaticResource {x:Type MenuItem}}" Padding="6,3" Background="#FF3F3F46" BorderBrush="#FF555555" BorderThickness="1">
                            <MenuItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AutoFix" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Công cụ Fix" Margin="4,0,4,0" VerticalAlignment="Center"/>
                                        <iconPacks:PackIconMaterial Kind="ChevronDown" Width="10" Height="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </MenuItem.HeaderTemplate>
                            <MenuItem Click="FixHevaButton_Click" Header="Sửa \heva{}"/>
                            <MenuItem Click="FixEnumerateButton_Click" Header="Fix Enumerate sang listEX"/>
                            <MenuItem Click="FixTikzpictureButton_Click" Header="Fix Tikzpicture"/>
                            <Separator Background="#FF555555"/>
                            <MenuItem Command="local:CustomCommands.CleanupText" Header="Dọn dẹp văn bản"/>
                        </MenuItem>
                    </Menu>
                    <Button Click="InsertImageWizardButton_Click" ToolTip="Mở wizard chèn hình ảnh nâng cao" Margin="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ImagePlus" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Chèn ảnh" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Ghepfile_Click" ToolTip="Ghép các tệp TeX lại với nhau" Margin="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileMultipleOutline" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Ghép file" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 3. Khu vực soạn thảo văn bản -->
        <avalonedit:TextEditor
            Grid.Row="2"
            x:Name="textEditor"
            FontFamily="Tono Mono"
            FontSize="12pt"
            Background="#FF1E1E1E"
            Foreground="#FFDCDCDC"
            ShowLineNumbers="True"
            Margin="0,5,0,0"
            WordWrap="True"
            >
            <avalonedit:TextEditor.InputBindings>
                <!-- Gán phím tắt Ctrl+W cho lệnh đóng tệp -->
                <KeyBinding Command="{x:Static local:MainWindow.CloseTexCommand}"
                            Key="W" Modifiers="Ctrl"/>

                <!-- Gán phím tắt Ctrl+Shift+U cho lệnh viết hoa -->
                <KeyBinding Command="avalonedit:AvalonEditCommands.ConvertToUppercase"
                            Key="U" Modifiers="Ctrl+Shift"/>
                <KeyBinding Command="local:CustomCommands.MathMode" Key="M" Modifiers="Ctrl"/>
                <KeyBinding Command="local:CustomCommands.SpellCheck" Key="F7" Modifiers="Ctrl"/>
                <KeyBinding Key="L" Modifiers="Ctrl" Command="local:CustomCommands.InsertLoigiai"/>
                <KeyBinding Command="local:CustomCommands.ToggleComment" Key="T" Modifiers="Ctrl"/>
                <KeyBinding Command="local:CustomCommands.ToggleComment" Key="U" Modifiers="Ctrl"/>
                <KeyBinding Command="ApplicationCommands.Find" Key="F" Modifiers="Ctrl"/>
                <KeyBinding Command="ApplicationCommands.Replace" Key="H" Modifiers="Ctrl"/>
            </avalonedit:TextEditor.InputBindings>
            <avalonedit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Cut">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ContentCut" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cắt"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="ApplicationCommands.Copy">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Sao chép"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="ApplicationCommands.Paste">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ContentPaste" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Dán"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="avalonedit:AvalonEditCommands.ConvertToUppercase">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="FormatLetterCaseUpper" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Viết hoa"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="TitleCaseDang_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="FormatTitle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Viết hoa tiêu đề dạng toán"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="UppercaseSection_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="FormatHeader1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Viết hoa mục (section)"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="SortQuestions_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="Sort" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Sắp xếp câu hỏi"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="local:CustomCommands.ToggleComment">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="CommentTextOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chuyển đổi Ghi chú"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="local:CustomCommands.CleanupText">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="Broom" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Dọn dẹp văn bản"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="LabelMenuItem_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="Label" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chèn \label{}"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="RefMenuItem_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="Tag" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chèn \ref{}"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator Background="#FF555555"/>
                    <MenuItem Command="ApplicationCommands.SelectAll">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="SelectAll" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chọn tất cả"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator Background="#FF555555"/>
                    <MenuItem Click="ExpandAllFoldings_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ArrowExpandAll" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Mở tất cả"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="CollapseAllFoldings_Click">
                        <MenuItem.Header>
                            <DockPanel>
                                <iconPacks:PackIconMaterial Kind="ArrowCollapseAll" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Đóng tất cả"/>
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </avalonedit:TextEditor.ContextMenu>
        </avalonedit:TextEditor>

        <!-- 4. Thanh trạng thái dưới cùng -->
        <StatusBar Grid.Row="3" Background="#FF1E1E1E" Foreground="#FF969696" BorderThickness="0,1,0,0" BorderBrush="#FF555555" Height="24" Padding="5,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusMessageTextBlock" Text="Sẵn sàng" Margin="5,0,15,0" FontWeight="SemiBold" Foreground="#FF007ACC"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="FilePathTextBlock" Text="Chưa mở tệp nào" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,10,0">
                <TextBlock x:Name="CaretPositionTextBlock" Text="Ln 1, Col 1" FontFamily="Consolas"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
