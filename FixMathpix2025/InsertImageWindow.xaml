<Window x:Class="FixMathpix2025.InsertImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chèn hình ảnh" Height="380" Width="504"
        WindowStartupLocation="CenterOwner"
        Background="#FF2D2D30" Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Image Path -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Đường dẫn ảnh:" Grid.Column="0" Margin="0,0,10,0"/>
            <TextBox x:Name="ImagePathTextBox" Grid.Column="1" Height="25"/>
            <Button x:Name="BrowseButton" Content="..." Grid.Column="2" Width="30" Height="25" Click="BrowseButton_Click" Margin="5,0,0,0"/>
        </Grid>

        <!-- Options -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tùy chọn (width=...):" Grid.Column="0" Margin="0,0,10,0"/>
            <TextBox x:Name="OptionsTextBox" Grid.Column="1" Text="width=0.8\textwidth" Height="25"/>
        </Grid>

        <!-- Environment -->
        <GroupBox Header="Môi trường bao quanh" Grid.Row="2" Padding="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioNone" Content="Không" IsChecked="True"/>
                    <RadioButton x:Name="RadioCenter" Content="\begin{center}"/>
                    <RadioButton x:Name="RadioHinhanh" Content="\begin{hinhanh}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Độ rộng (cho hinhanh):" Margin="0,0,10,0"/>
                    <TextBox x:Name="HinhanhWidthTextBox" Width="100" IsEnabled="{Binding IsChecked, ElementName=RadioHinhanh}" Text="0.8" Height="25"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Caption -->
        <Grid Grid.Row="3" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Caption:" Grid.Column="0"/>
            <TextBox x:Name="CaptionTextBox" Grid.Column="1" Height="25"/>
        </Grid>

        <!-- Label -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Label (fig:...):" Grid.Column="0"/>
            <TextBox x:Name="LabelTextBox" Grid.Column="1" Height="25"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Chèn" Width="80" Height="30" Click="InsertButton_Click" IsDefault="True"/>
            <Button Content="Hủy" Width="80" Height="30" Click="CancelButton_Click" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
